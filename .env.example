# Never commit real secrets. Copy to `.env` (gitignored) and fill in.
# External Aiven MySQL: set DB_HOST/DB_PORT/DB_USER/DB_PASS/DB_NAME + DB_SSL=true.
# For full TLS verification download Aiven ca.pem to ./certs/aiven-ca.pem (gitignored)
# and set DB_SSL_CA_PATH=./certs/aiven-ca.pem. Without it, dev fallback encrypts
# without chain verification (do not use for production).
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=shipyard
DB_PASS=shipyard
DB_NAME=shipyard
DB_SSL=false
DB_SSL_CA_PATH=./certs/aiven-ca.pem
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
LOG_LEVEL=info
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/github/callback
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000
DB_ENV_KEY=
# ^ 32-byte key for env-var encryption at rest (generate: 64 hex chars).
# Without it, env values are stored plaintext (dev only).
